# Example only. The API does not load this file.
# Set the variables in the process environment or the deployment secret manager.
# Never commit real values. Never put them in Flutter, logs, or appsettings.json.
#
# Runtime connection for this school's deployment only.
# The migration creates the role smart_school_app as NOLOGIN.
# An administrator must grant LOGIN and set its password outside the application.
# The path is that school's existing database name. It is not shared with another school.
# A non-local host must use sslmode=require, verify-ca, or verify-full.
# channel_binding=require is accepted and should be included for Neon.
DATABASE_URL=postgresql://smart_school_app:CHANGE_ME@HOST/SCHOOL_DATABASE?sslmode=require&channel_binding=require

# Non-secret. Must exactly match the database name in DATABASE_URL and current_database().
# The API and provision-admin refuse to run when it is missing or different.
# dotnet run -- migrate also refuses when MIGRATION_DATABASE_URL names a different database.
EXPECTED_DATABASE_NAME=SCHOOL_DATABASE

# Used only by: dotnet run -- migrate
# Must name the same school database. The command does not create a database,
# does not fall back to DATABASE_URL, and refuses the postgres maintenance database
# and the marketing database neondb.
MIGRATION_DATABASE_URL=postgresql://school_owner:CHANGE_ME@HOST/SCHOOL_DATABASE?sslmode=require&channel_binding=require

# At least 32 random characters. The API reads this key, not a value in appsettings.json.
AUTH_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS

# Issuer and audience come from appsettings.json Auth:Issuer and Auth:Audience.
# Override them with environment variables Auth__Issuer and Auth__Audience.
# AUTH_ISSUER and AUTH_AUDIENCE are not read.

# Used only by: dotnet run -- provision-admin
# BOOTSTRAP_SCHOOL_NAME=
# BOOTSTRAP_BRANCH_NAME=Main
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
